{
    "name": "langapp-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Language learning app backend — Node.js + Express + Prisma + PostgreSQL",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "seed": "tsx prisma/seed.ts",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "argon2": "^0.41.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.23.0",
        "pino": "^9.5.0",
        "pino-http": "^10.3.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.0.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.9.0",
        "@types/supertest": "^6.0.2",
        "@types/swagger-ui-express": "^4.1.6",
        "eslint": "^9.15.0",
        "jest": "^29.7.0",
        "prisma": "^7.10.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
